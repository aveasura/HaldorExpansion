        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>HaldorExpansion</RootNamespace>
        <AssemblyName>HaldorExpansion</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
    </PropertyGroup>
    
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <PropertyGroup>
        <!--
        Local development paths.
    
        These values are used only when they were not already provided by:
        - HaldorExpansion.Local.props
        - Rider / Visual Studio
        - MSBuild command line
    
        If your r2modman profile is not named "Default", override R2ModmanProfileDir
        in HaldorExpansion.Local.props.
        -->

        <R2ModmanProfileDir Condition=" '$(R2ModmanProfileDir)' == '' ">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</R2ModmanProfileDir>

        <!-- Path to the Valheim client installation. Used for Valheim and Unity assemblies. -->
        <ValheimInstallDir Condition=" '$(ValheimInstallDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>

        <!-- Path to the Valheim dedicated server installation. Used only for local PostBuild deployment. -->
        <ValheimDedicatedServerDir Condition=" '$(ValheimDedicatedServerDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server</ValheimDedicatedServerDir>

        <!-- Local plugin deployment folders. The compiled DLL is copied here after build. -->
        <ClientPluginDeployDir Condition=" '$(ClientPluginDeployDir)' == '' ">$(R2ModmanProfileDir)\BepInEx\plugins\aveasura-HaldorExpansion</ClientPluginDeployDir>
        <ServerPluginDeployDir Condition=" '$(ServerPluginDeployDir)' == '' ">$(ValheimDedicatedServerDir)\BepInEx\plugins\aveasura-HaldorExpansion</ServerPluginDeployDir>

        <!-- Keep true for your current workflow. Can be overridden in HaldorExpansion.Local.props. -->
        <DeployToClientProfile Condition=" '$(DeployToClientProfile)' == '' ">true</DeployToClientProfile>
        <DeployToDedicatedServer Condition=" '$(DeployToDedicatedServer)' == '' ">true</DeployToDedicatedServer>
        <CopyToDesktop Condition=" '$(CopyToDesktop)' == '' ">true</CopyToDesktop>
    </PropertyGroup>

