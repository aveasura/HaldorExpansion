    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>

    <!--
    Local development deployment.
    
    After build, the compiled DLL can be copied to:
    - r2modman client profile
    - Valheim dedicated server
    - Desktop
    
    This does not affect the mod logic. It only helps with local testing.
    -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Copy
                Condition=" '$(DeployToClientProfile)' == 'true' "
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(ClientPluginDeployDir)\"
                SkipUnchangedFiles="true"/>

        <Copy
                Condition=" '$(DeployToDedicatedServer)' == 'true' "
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(ServerPluginDeployDir)\"
                SkipUnchangedFiles="true"/>

        <Copy
                Condition=" '$(CopyToDesktop)' == 'true' "
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(USERPROFILE)\Desktop\"
                SkipUnchangedFiles="true"/>
    </Target>

